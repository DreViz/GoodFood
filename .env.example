# Copy to .env and fill in as needed. Every key has a safe local default in
# app/config.py, so the app boots without a .env for local development.

# ---- Ollama LLM ----
# Base URL of the Ollama server (endpoint paths are derived in code).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model tag served by Ollama. qwen3:4b = dev/iteration; qwen3:8b = eval.
OLLAMA_MODEL=qwen3:4b
# qwen3 reasoning toggle. false = faster + cleaner output on CPU.
OLLAMA_THINK=false
# Per-request timeout in seconds (qwen3:4b ~6 tok/s CPU-only).
OLLAMA_TIMEOUT=180

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodfoods

# ---- Email (SMTP via Gmail) ----
# Leave blank to disable confirmation emails (sends silently no-op).
GOODFOODS_EMAIL=
GOODFOODS_EMAIL_PASSWORD=

# ---- API ----
# Comma-separated allowed CORS origins (used from Phase 2 onward).
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
